# Obrigatória — usada pela função serverless em api/lastfm.ts (não tem
# prefixo VITE_ de propósito: não deve chegar ao bundle do navegador).
# Só é lida localmente se você rodar `vercel dev` (veja o README).
LASTFM_API_KEY=sua_api_key_do_lastfm

# Opcionais (têm valor padrão)
# VITE_SPOTIFY_URL=https://api.spotify.com/v1
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_CLIENT_SECRET=
# VITE_MUSICBRAINZ_URL=https://musicbrainz.org/ws/2
