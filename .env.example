# --- Last.fm (obrigatórias) ---
# Crie uma API key em https://www.last.fm/api/account/create
VITE_API_KEY=sua_api_key_do_lastfm
VITE_LASTFM_URL=https://ws.audioscrobbler.com/2.0/

# --- Opcionais (já têm esses defaults no código) ---
# VITE_SPOTIFY_URL=https://api.spotify.com/v1
# VITE_MUSICBRAINZ_URL=https://musicbrainz.org/ws/2

# --- Server-side (SEM prefixo VITE_; nunca vão para o bundle) ---
# Usadas pela função api/spotify-token.ts. Em produção, configure no
# dashboard da Vercel; localmente só são necessárias com `vercel dev`.
# Crie um app em https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
